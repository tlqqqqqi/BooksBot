BOT_TOKEN=
BOT_PASSWORD=secret
FLIBUSTA_BASE_URL=https://flibusta.is
# Зеркала libgen: bz / vg / li / la / gl — содержимое одно, доступность разная.
# Актуальность зеркал: https://open-slum.org/
LIBGEN_BASE_URL=https://libgen.bz
REQUEST_TIMEOUT=60
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50
DB_PATH=flibusta_bot.db
WATCH_INTERVAL_HOURS=3
# Разослать анонс обновления всем авторизованным (уйдёт один раз, потом можно выключить)
SEND_ANNOUNCEMENT=false
